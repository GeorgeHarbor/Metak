<?xml version="1.0" encoding="utf-8"?>
<!-- Fades the backdrop into black at the bottom and darkens the left for the title -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape>
            <gradient android:angle="270" android:centerColor="#55000000"
                android:endColor="#FF000000" android:startColor="#00000000" />
        </shape>
    </item>
    <item>
        <shape>
            <gradient android:angle="0" android:endColor="#00000000"
                android:startColor="#B3000000" />
        </shape>
    </item>
</layer-list>
