<?xml version="1.0" encoding="utf-8"?>
<!-- iOS search field: a rounded translucent bar that lightens like a row when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="#4A4A4F" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#B31C1C1E" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
