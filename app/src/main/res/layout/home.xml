<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <!-- Two layers so a new background can fade in over the old one -->
    <FrameLayout
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:forceHasOverlappingRendering="false">

        <ImageView
            android:id="@+id/backdrop_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/backdrop_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim" />

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingBottom="48dp">

            <LinearLayout
                android:id="@+id/hero"
                android:layout_width="match_parent"
                android:layout_height="300dp"
                android:clipChildren="false"
                android:gravity="bottom"
                android:orientation="vertical"
                android:paddingBottom="32dp">

                <!-- Fills the empty space above the hero text and centers the clock in it. -->
                <LinearLayout
                    android:id="@+id/clock_widget"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:orientation="vertical">

                    <TextClock
                        android:id="@+id/clock_time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="H:mm"
                        android:fontFamily="sans-serif-thin"
                        android:shadowColor="#99000000"
                        android:shadowRadius="12"
                        android:textColor="#F5F5F7"
                        android:textSize="76sp" />

                    <TextClock
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="EEEE, d MMMM"
                        android:format24Hour="EEEE, d MMMM"
                        android:fontFamily="sans-serif-medium"
                        android:shadowColor="#99000000"
                        android:shadowRadius="8"
                        android:textColor="#F5F5F7"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:id="@+id/weather"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/weather_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="sans-serif-medium"
                            android:shadowColor="#99000000"
                            android:shadowRadius="8"
                            android:textColor="#F5F5F7"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/weather_city"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:shadowColor="#99000000"
                            android:shadowRadius="8"
                            android:textColor="#B3F5F5F7"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/hero_title"
                    android:layout_width="720dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#F5F5F7"
                    android:textSize="24sp" />

                <TextView
                    android:id="@+id/hero_subtitle"
                    android:layout_width="720dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="48dp"
                    android:layout_marginTop="2dp"
                    android:layout_marginBottom="8dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#B3F5F5F7"
                    android:textSize="14sp" />

                <HorizontalScrollView
                    android:id="@+id/shelf_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:paddingHorizontal="48dp"
                    android:paddingVertical="12dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/shelf"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clipChildren="false"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/dock_frame"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:background="@drawable/dock_clip">

                <!-- Blurred copy of the backdrop, lined up with it in code: frosted glass.
                     Sized to the dock in code so the bitmap never stretches the frame. -->
                <ImageView
                    android:id="@+id/dock_blur"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:importantForAccessibility="no"
                    android:scaleType="matrix" />

                <LinearLayout
                    android:id="@+id/dock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/dock_bg"
                    android:clipChildren="false"
                    android:orientation="horizontal"
                    android:padding="6dp" />
            </FrameLayout>

            <GridLayout
                android:id="@+id/apps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:clipChildren="false"
                android:columnCount="7" />
        </LinearLayout>
    </ScrollView>

    <ImageView
        android:id="@+id/gear"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="top|end"
        android:layout_margin="24dp"
        android:background="@drawable/gear_bg"
        android:clickable="true"
        android:contentDescription="@string/settings"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/ic_gear" />

</FrameLayout>
